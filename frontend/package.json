{
  "name": "algebra-adventure",
  "private": true,
  "version": "0.1.0",
  "description": "Algebra Adventure — PWA pembelajaran pemfaktoran bentuk aljabar untuk SMP kelas VII",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "//": "Binari dipanggil lewat node langsung karena nama folder induk berisi '&' yang merusak pintasan .cmd npm di Windows.",
    "dev": "node node_modules/vite/bin/vite.js",
    "ai": "node ../backend/src/server.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "npm run test:math && npm run test:ui",
    "test:math": "node --test \"src/math/*.test.js\"",
    "test:ui": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "npm run build && node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/fredoka": "^5.2.5",
    "@fontsource/nunito": "^5.2.5",
    "@react-three/fiber": "^9.8.2",
    "idb-keyval": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "three": "^0.187.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.3"
  }
}
