# Salin file ini menjadi backend/.env lalu isi nilainya. File .env TIDAK di-commit (lihat .gitignore).
# Jangan pernah menulis API key di kode frontend, di chat, atau di GitHub.

# Penyedia AI. Saat ini: deepseek. Kosongkan AI_API_KEY untuk menonaktifkan AI (aplikasi tetap berjalan).
AI_PROVIDER=deepseek
AI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Server proxy
PORT=8787
# Asal (origin) frontend yang boleh memanggil proxy saat di-hosting terpisah. Kosong = hanya lewat proxy Vite (same-origin).
ALLOWED_ORIGIN=

# Batas penggunaan per alamat IP (melindungi saldo API)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MIN=10
# Batas waktu menunggu jawaban AI (milidetik) dan panjang jawaban (token)
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=400
